# Supabase Configuration (Client-side public keys - set in Vercel Project Settings -> Environment Variables)
# Obtain from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: Firebase Web Config overrides for Google OAuth on Vercel
# (If omitted, the app automatically uses firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

# Optional: WhatsApp Gateway API (used inside Supabase Edge Functions)
# WHATSAPP_API_URL="https://api.fonnte.com/send"
# WHATSAPP_API_TOKEN="your-fonnte-token"

# APP_URL: The URL where this applet is hosted (e.g. https://your-app.vercel.app)
APP_URL="MY_APP_URL"
