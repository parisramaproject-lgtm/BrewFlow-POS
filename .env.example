# Supabase Configuration (Client-side public keys - set in Vercel Project Settings -> Environment Variables)
# Obtain from Supabase Dashboard -> Project Settings -> API
# Note: Vercel x Supabase Marketplace env vars (NEXT_PUBLIC_SUPABASE_URL & NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY) are also automatically supported.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: WhatsApp Gateway API (used inside Supabase Edge Functions)
# WHATSAPP_API_URL="https://api.fonnte.com/send"
# WHATSAPP_API_TOKEN="your-fonnte-token"

# Owner Login Email Alert (Vercel Environment Variables — NEVER prefix with VITE_)
# Recommended: Google Gmail App Password (Sandi Aplikasi 16 karakter dari myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
OWNER_ALERT_EMAIL="parisramaproject@gmail.com"
# Optional alternative (Resend API)
RESEND_API_KEY=
ALERT_FROM_EMAIL="BrewFlow POS <onboarding@resend.dev>"

# APP_URL / VITE_APP_URL: Canonical hosting URL for Google OAuth redirects
VITE_APP_URL="https://brewflow-pos.vercel.app"
APP_URL="MY_APP_URL"
